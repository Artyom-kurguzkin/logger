<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Host / composition root: the only project with UI and DI. Built-in features are IExtension classes registered from Program.cs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AkLogger</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Radzen.Blazor" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AkLogger.Sdk/AkLogger.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
